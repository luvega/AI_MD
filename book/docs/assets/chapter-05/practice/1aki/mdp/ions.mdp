; AI_MD teaching input, GROMACS 2025.5; ion-replacement preprocessing only
integrator = steep
nsteps = 5000
emtol = 1000
emstep = 0.01
cutoff-scheme = Verlet
nstlist = 20
; This TPR is used only by genion before neutralization; no MD is run from it.
coulombtype = Cut-off
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pbc = xyz

